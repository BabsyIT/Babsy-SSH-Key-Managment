# Sudo configuration for {{ user_item.local_user }}
# Verwaltet von Babsy-SSH-Key-Managment (Ansible)
# Limited sudo access - only specified commands allowed

{{ user_item.local_user }} ALL=(ALL:ALL) NOPASSWD: \
{% for cmd in user_item.sudo_commands %}
    {{ cmd }}{{ ',' if not loop.last else '' }}
{% endfor %}
